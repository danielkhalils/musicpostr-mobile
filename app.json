{
  "expo": {
    "name": "Musicpostr",
    "slug": "musicpostr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_512x512.png",
    "scheme": "musicpostr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.musicpostr.mobile",
      "supportsTablet": true,
      "icon": "./assets/icon_512x512.png"
    },
    "android": {
      "package": "com.musicpostr.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#170529",
        "foregroundImage": "./assets/icon_transparent_512x512.png",
        "monochromeImage": "./assets/icon_transparent_512x512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/icon_transparent_48x48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/icon_transparent_512x512.png",
          "imageWidth": 110
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e5b3e5a-45f7-4e58-b1df-a6dd0764daca"
      }
    }
  }
}
